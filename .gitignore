# Rust compilation output is reproducible from Cargo.lock and the pinned toolchain.
target/
**/*.rs.bk

# Platform/editor state does not belong to the portable source repository.
.DS_Store
.AppleDouble/
.idea/
.vscode/
*.swp
*.swo
*~
__pycache__/
*.py[cod]

# Local credentials and overrides must never change the committed dependency graph.
.env
.env.*
!.env.example
.secrets/
*.pem
*.p12
*.pfx
*.key
*.p8
*.mobileprovision
id_ed25519
id_rsa
id_ecdsa
id_dsa
# Ignore the explicit machine-local override while allowing reviewed shared build configuration.
/.cargo/config.local.toml
**/.cargo/credentials
**/.cargo/credentials.toml
.cargo-ok

# Native packaging and local diagnostic artifacts are outputs, not source inputs.
*.app/
*.dmg
*.dSYM/
*.trace/
*.crash
*.log
*.profraw
*.profdata
*.memgraph
*.heap
*.sample
*.spindump
/benchmarks/output/
/local-output/

# AI rules, session traces, and local tool configuration are not plugin source or required build inputs.
/.agents/
/.codex/
/.trellis/
/AGENTS.md
/CLAUDE.md
/.cursor/
/.windsurf/
/.claude/

# JavaScript is an offline reference-generator tool; installed dependencies remain local output.
node_modules/

# Keep this sample-config exception after diagnostic *.sample exclusions so the reviewed example remains visible.
!.env.sample
