# Rust compilation output is reproducible from Cargo.lock and the pinned toolchain.
target/
**/*.rs.bk

# Platform/editor state does not belong to the portable source repository.
.DS_Store
.AppleDouble/
.idea/
.vscode/
*.swp
*.swo
*~
__pycache__/
*.py[cod]

# Local credentials and overrides must never change the committed dependency graph.
.env
.env.*
!.env.example
!.env.sample
.secrets/
*.pem
*.p12
*.pfx
*.key
*.p8
*.mobileprovision
id_ed25519
id_rsa
/.cargo/config.toml

# Native packaging and local diagnostic artifacts are outputs, not source inputs.
*.app/
*.dmg
*.dSYM/
*.trace/
*.crash
*.log
*.profraw
*.profdata
*.memgraph
*.heap
*.sample
*.spindump
/benchmarks/output/
/local-output/

# JavaScript is an offline reference-generator tool; installed dependencies remain local output.
node_modules/
